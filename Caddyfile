# Used only with: docker compose --profile caddy up -d
# Same Docker network as api/admin/mediamtx → short service names are correct here.
#
# If another process already owns :80/:443, do NOT use the caddy profile.
# Use deploy/existing-docker-caddy.Caddyfile (or nginx / host Caddy) instead.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# MediaMTX WebRTC HTTP (WHIP/WHEP + SDP): paths like /live/{id}/whip
	handle /live/* {
		reverse_proxy mediamtx:8889
	}

	handle {
		reverse_proxy admin:80
	}
}
