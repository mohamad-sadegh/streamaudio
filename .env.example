# Public hostname (DNS A/AAAA must point at this server)
DOMAIN=stream.example.com

# Optional ACME email for Let's Encrypt
ACME_EMAIL=admin@example.com

# Bootstrap admin (created only when no admin exists)
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# Long random secret for JWT sessions / listen tokens
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# PostgreSQL
POSTGRES_USER=stream
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=streamaudio
DATABASE_URL=postgres://stream:replace-with-strong-db-password@postgres:5432/streamaudio

# Comma-separated IPs allowed to hit admin login (empty = allow any)
ADMIN_LOGIN_IP_ALLOWLIST=

# Public host/IP advertised in WebRTC ICE (usually same as DOMAIN)
WEBRTC_ADDITIONAL_HOSTS=stream.example.com

# Cookie / TLS
NODE_ENV=production
COOKIE_SECURE=true
